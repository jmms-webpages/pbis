# Copy this file to .env.local and fill in values from:
# Firebase Console > Project Settings > General > Your apps > SDK setup and configuration

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Your school's Google Workspace domain(s) — comma-separated if you have
# more than one (e.g. a district domain plus a student-specific subdomain).
# Example: "jackson.sparcc.org,bearkworks.jackson.sparcc.org"
# This only gives a friendlier error message during sign-in — the actual
# enforcement lives in firestore.rules (isAllowedSchoolEmail), which you
# should edit to match the same list.
VITE_SCHOOL_GOOGLE_DOMAINS=
